diff --git a/Tests/WorkBoardResizePerf.swift b/Tests/WorkBoardResizePerf.swift
new file mode 100644
index 0000000..40c6c54
--- /dev/null
+++ b/Tests/WorkBoardResizePerf.swift
@@ -0,0 +1,104 @@
+import AppKit
+import SwiftUI
+
+/// 0.5.254: resizing the Work board must not rebuild every card. The window is created off screen and never ordered
+/// in. Nothing is clicked, typed or dragged.
+@MainActor func runWorkBoardResizeChecks() {
+    let memo = WorkBoardMemo()
+    let key = WorkBoardDataKey(tasks: 1, receipts: 4)
+    var builds = 0
+    for _ in 0..<6 { _ = memo.items(key: key) { builds += 1; return [] } }
+    precondition(builds == 1 && memo.builds == 1, "the board rebuilt on an unchanged key: \(builds)")
+    var moved = key
+    moved.receipts = 5
+    _ = memo.items(key: moved) { builds += 1; return [] }
+    precondition(builds == 2, "a journal change must rebuild")
+    precondition(WorkBoardLayout.wide(900) && WorkBoardLayout.wide(1900) && !WorkBoardLayout.wide(899.9))
+
+    let stages = ["Planning", "Draft", "Active", "Review", "Mentioned", "Complete"]
+    let samples = (0..<268).map { index in
+        Control2PreviewTask(id: "resize-\(index)", title: "Resize task \(index) with a title long enough to wrap on the card",
+                            domain: index.isMultiple(of: 2) ? "quilt" : "personal", owner: "You", schedule: "Today",
+                            source: "Resize check", finishLine: "The card still reads after the window changes width.",
+                            stage: stages[index % stages.count])
+    }
+    let rows = WorkWorkspaceProjection.previewRows(samples)
+    var receipts: [WorkHandoffReceipt] = []
+    receipts.reserveCapacity(rows.count * 8)
+    for row in rows {
+        let source = WorkSource.taskSnapshot(row)
+        for copy in 0..<8 {
+            receipts.append(WorkHandoffReceipt(id: "\(source.id)#\(copy)", workID: source.id, workTitle: source.title,
+                                               sourceRevision: source.revision, mode: .continueSession, provider: "claude",
+                                               modelID: "existing-session", sessionID: nil, sessionTitle: "", status: "delivered",
+                                               detail: "", prompt: "p", createdAt: Double(copy)))
+        }
+    }
+    WorkBoardMetrics.projections = 0
+    let clock = ContinuousClock()
+    let started = clock.now
+    let projected = WorkWorkspaceProjection.items(tasks: rows, reviews: [], receipts: receipts, sessions: [])
+    let once = clock.now - started
+    precondition(projected.count == 268, "projection dropped rows: \(projected.count)")
+    precondition(WorkBoardMetrics.projections == 1)
+    let onceMs = milliseconds(once)
+    let naiveStarted = clock.now
+    for _ in 0..<6 {
+        for row in rows {
+            let id = WorkSource.taskSnapshot(row).id
+            _ = receipts.filter { $0.workID == id }.max(by: { $0.createdAt < $1.createdAt })
+        }
+    }
+    let naiveMs = milliseconds(clock.now - naiveStarted)
+
+    NSApplication.shared.setActivationPolicy(.prohibited)
+    let store = WorkHandoffStore(isolated: true, transport: { _, _ in
+        throw HelperClientError.invalidResponse("The resize check never calls the helper.")
+    })
+    store.previewTasks = samples
+    store.receipts = receipts
+    let model = ControllerModel(startBackgroundWork: false)
+    let state = WorkWorkspaceState()
+    let board = WorkWorkspaceView(model: model, handoffStore: store, reviewStore: WorkReviewStore(transport: { _, _ in
+        throw HelperClientError.invalidResponse("The resize check never reviews a meeting.")
+    }), state: state, onOpenSession: { _ in }, onEditTask: { _ in }, onReviewMeeting: { _ in })
+    WorkBoardMetrics.bodies = 0
+    WorkBoardMetrics.projections = 0
+    let host = NSHostingView(rootView: board.frame(maxWidth: .infinity, maxHeight: .infinity))
+    let window = NSWindow(contentRect: NSRect(origin: NSPoint(x: -20000, y: -20000), size: NSSize(width: 1200, height: 800)),
+                          styleMask: [.borderless], backing: .buffered, defer: false)
+    window.contentView = host
+    host.frame = NSRect(x: 0, y: 0, width: 1200, height: 800)
+    for _ in 0..<3 {
+        RunLoop.main.run(until: Date().addingTimeInterval(0.05))
+        window.contentView?.layoutSubtreeIfNeeded()
+    }
+    let settledBodies = WorkBoardMetrics.bodies
+    let settledProjections = WorkBoardMetrics.projections
+    precondition(settledBodies > 0 && settledProjections > 0 && settledProjections <= 2,
+                 "first layout bodies \(settledBodies) projections \(settledProjections)")
+    var slowestMs = 0.0
+    for step in 0..<8 {
+        let width = CGFloat(1200 + step * 100)
+        let mark = clock.now
+        host.frame.size.width = width
+        window.setContentSize(NSSize(width: width, height: 800))
+        window.contentView?.layoutSubtreeIfNeeded()
+        let stepMs = milliseconds(clock.now - mark)
+        if stepMs > slowestMs { slowestMs = stepMs }
+    }
+    RunLoop.main.run(until: Date().addingTimeInterval(0.15))
+    window.contentView?.layoutSubtreeIfNeeded()
+    let bodyDelta = WorkBoardMetrics.bodies - settledBodies
+    let projectionDelta = WorkBoardMetrics.projections - settledProjections
+    let line = String(format: "PASS Work board resize: indexed projection %.2f ms vs %.2f ms for six full scans; slowest width step %.2f ms in this unoptimized host; body reruns %d; projection reruns %d\n",
+                      onceMs, naiveMs, slowestMs, bodyDelta, projectionDelta)
+    fputs(line, stderr)
+    precondition(onceMs < 40 && naiveMs > onceMs * 4, String(format: "indexed %.2f ms, six scans %.2f ms", onceMs, naiveMs))
+    precondition(projectionDelta == 0, "a resize rebuilt the board \(projectionDelta) times")
+    precondition(bodyDelta == 0, "a resize reran the Work view \(bodyDelta) times")
+}
+
+private func milliseconds(_ duration: Duration) -> Double {
+    Double(duration.components.seconds) * 1000 + Double(duration.components.attoseconds) / 1e15
+}
